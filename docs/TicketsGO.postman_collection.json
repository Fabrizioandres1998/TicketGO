      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 200) {\n    const body = pm.response.json();\n    pm.collectionVariables.set(\"token\", body.accessToken);\n    pm.test(\"Login correcto\", function () {\n        pm.response.to.have.status(200);\n    });\n}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin@test.com\",\n  \"password\": \"123456\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
