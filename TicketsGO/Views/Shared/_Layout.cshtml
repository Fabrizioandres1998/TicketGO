<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TicketsGO</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TicketsGO.styles.css" asp-append-version="true" />
</head>

<body class="bg-dark text-light">
    <header>
        <nav
            class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark bg-black border-bottom border-secondary mb-3">
            <div class="container-fluid">
                <a class="navbar-brand text-light" asp-area="" asp-controller="Home" asp-action="Index">TicketsGO</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                       
                        @if (User.Identity?.IsAuthenticated == true && (User.IsInRole("Productor") ||
                         User.IsInRole("Administrador")))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-light" asp-controller="Evento" asp-action="GestionVue">Gestionar
                                    eventos</a>
                                </li>
                            }
                            @if (User.Identity?.IsAuthenticated == true && User.IsInRole("Administrador"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-light" asp-controller="Usuario" asp-action="Index">Usuarios</a>
                                </li>
                            }
                        </ul>

                        <ul class="navbar-nav">
                            @if (User.Identity?.IsAuthenticated == true)
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-light" asp-controller="Usuario" asp-action="MyDetails">Mi perfil</a>
                                </li>
                                <li class="nav-item d-flex align-items-center">
                                    @{
                                        var avatarUrl = User.FindFirst("AvatarUrl")?.Value;
                                    }
                                    @if (!string.IsNullOrWhiteSpace(avatarUrl))
                                    {
                                        <img src="@avatarUrl" alt="Avatar" class="rounded-circle me-2 border border-secondary"
                                             style="width:32px;height:32px;object-fit:cover;" />
                                    }
                                    <span class="navbar-text text-light me-3">
                                        @(User.FindFirst("NombreCompleto")?.Value ?? User.Identity?.Name)
                                    </span>
                                </li>
                                <li class="nav-item">
                                    <form asp-controller="Usuario" asp-action="Logout" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-outline-danger btn-sm">Cerrar sesión</button>
                                    </form>
                                </li>
                            }
                            else
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-light" asp-controller="Usuario" asp-action="Login">Iniciar
                                        sesión</a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link text-light" asp-controller="Usuario"
                                           asp-action="Register">Registrarse</a>
                                    </li>
                                }
                            </ul>
                        </div>
                    </div>
                </nav>
            </header>

            <div class="container">
                <main role="main" class="pb-3">
                    @RenderBody()
                </main>
            </div>

            <footer class="border-top border-secondary footer text-muted bg-black">
                <div class="container py-3">
                    &copy; 2026 - TicketsGO - <a asp-area="" asp-controller="Home" asp-action="Privacy"
                                                 class="text-secondary">Privacy</a>
                </div>
            </footer>

            <script src="~/lib/jquery/dist/jquery.min.js"></script>
            <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
            <script src="~/js/site.js" asp-append-version="true"></script>
            @await RenderSectionAsync("Scripts", required: false)
        </body>

    </html>