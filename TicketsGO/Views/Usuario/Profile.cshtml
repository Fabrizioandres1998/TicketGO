@model TicketsGO.DTOs.UsuarioEditDTO

@{
    ViewData["Title"] = "Editar perfil";
}

<div class="container py-5 bg-dark text-light min-vh-100">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card bg-black border-secondary shadow-lg rounded-4">
                <div class="card-body p-4 p-md-5">

                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h1 class="h3 fw-bold mb-0">Editar perfil</h1>
                        <a asp-action="MyDetails" class="btn btn-outline-light btn-sm">Volver</a>
                    </div>

                    <form asp-action="Profile" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="AvatarUrl" />

                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="text-center mb-4">
                            @if (!string.IsNullOrWhiteSpace(Model.AvatarUrl))
                            {
                                <img src="@Model.AvatarUrl" alt="Avatar actual"
                                     class="rounded-circle border border-secondary"
                                     style="width:100px;height:100px;object-fit:cover;" />
                            }
                            else
                            {
                                <div class="rounded-circle border border-secondary d-inline-flex align-items-center justify-content-center"
                                     style="width:100px;height:100px;">
                                    <span class="text-white-50 small">Sin avatar</span>
                                </div>
                            }
                        </div>

                        <div class="mb-4">
                            <label asp-for="Avatar" class="form-label"></label>
                            <input asp-for="Avatar" type="file" accept=".jpg,.jpeg,.png,.webp"
                                   class="form-control bg-dark text-light border-secondary" />
                            <span asp-validation-for="Avatar" class="text-danger small"></span>
                            <div class="form-text text-white-50">JPG, PNG o WEBP. Máximo 2 MB.</div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Nombre" class="form-label"></label>
                                <input asp-for="Nombre" class="form-control bg-dark text-light border-secondary" />
                                <span asp-validation-for="Nombre" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Apellido" class="form-label"></label>
                                <input asp-for="Apellido" class="form-control bg-dark text-light border-secondary" />
                                <span asp-validation-for="Apellido" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Telefono" class="form-label"></label>
                            <input asp-for="Telefono" class="form-control bg-dark text-light border-secondary" />
                            <span asp-validation-for="Telefono" class="text-danger small"></span>
                        </div>

                        <div class="d-flex gap-2 mt-2">
                            <button type="submit" class="btn btn-success btn-lg flex-grow-1 fw-bold">Guardar
                                cambios</button>
                                <a asp-action="MyDetails" class="btn btn-outline-secondary btn-lg">Cancelar</a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @section Scripts {
        <partial name="_ValidationScriptsPartial" />
    }