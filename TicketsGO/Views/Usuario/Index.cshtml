@model TicketsGO.Services.PaginatedResult<TicketsGO.DTOs.UsuarioListDTO>

@{
    ViewData["Title"] = "Usuarios";
    var totalPaginas = (int)Math.Ceiling((double)Model.TotalCount / Model.PageSize);
    var inicio = Math.Max(1, Model.PageNumber - 2);
    var fin = Math.Min(totalPaginas, Model.PageNumber + 2);
}

<div class="container py-5 bg-dark text-light min-vh-100">
    <div class="row justify-content-center">
        <div class="col-12 col-xl-10">
            <div class="card bg-black border-secondary shadow-lg rounded-4">
                <div class="card-body p-4">
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger bg-danger text-light border-0">@TempData["Error"]</div>
                    }
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success bg-success text-light border-0">@TempData["Success"]</div>
                    }

                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h1 class="h3 fw-bold mb-0">Usuarios</h1>
                        <a asp-action="Create" class="btn btn-success">
                            + Nuevo usuario
                        </a>
                    </div>

                    @if (!Model.Items.Any())
                    {
                        <div class="alert alert-dark border-secondary text-light text-center">
                            No hay usuarios registrados.
                        </div>
                    }
                    else
                    {
                        <p class="text-white-50 small mb-3">
                            Mostrando @Model.Items.Count() de @Model.TotalCount usuarios
                            (página @Model.PageNumber de @totalPaginas)
                        </p>

                        <div class="table-responsive">
                            <table class="table table-dark table-hover align-middle mb-0">
                                <thead class="border-bottom border-secondary">
                                    <tr>
                                        <th>#</th>
                                        <th>Nombre</th>
                                        <th>Email</th>
                                        <th>Rol</th>
                                        <th>Estado</th>
                                        <th class="text-end">Acciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var usuario in Model.Items)
                                    {
                                        <tr>
                                            <td>@usuario.Id</td>
                                            <td>@usuario.NombreCompleto</td>
                                            <td class="text-white-50">@usuario.Email</td>
                                            <td>@usuario.Rol</td>
                                            <td>
                                                @if (usuario.EstadoTexto == "Activo")
                                                {
                                                    <span class="badge bg-success">@usuario.EstadoTexto</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger">@usuario.EstadoTexto</span>
                                                }
                                            </td>
                                            <td class="text-end">
                                                <a asp-action="Details" asp-route-id="@usuario.Id"
                                                   class="btn btn-sm btn-outline-info">Ver</a>
                                                <a asp-action="Edit" asp-route-id="@usuario.Id"
                                                   class="btn btn-sm btn-outline-warning">Editar</a>
                                                @if (usuario.EstadoTexto == "Activo")
                                                {
                                                    <a asp-action="Delete" asp-route-id="@usuario.Id"
                                                       class="btn btn-sm btn-outline-danger">Suspender</a>
                                                }
                                                else
                                                {
                                                    <form asp-action="Reactivar" asp-route-id="@usuario.Id" method="post"
                                                          class="d-inline">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit"
                                                                class="btn btn-sm btn-outline-success">Reactivar</button>
                                                    </form>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        @if (totalPaginas > 1)
                        {
                            <nav class="mt-4">
                                <ul class="pagination justify-content-center mb-0">
                                    <li class="page-item @(Model.PageNumber <= 1 ? "disabled" : "")">
                                        <a class="page-link bg-dark text-light border-secondary" asp-action="Index"
                                           asp-route-pagina="@(Model.PageNumber - 1)" aria-label="Anterior">&lsaquo;</a>
                                    </li>

                                    @if (inicio > 1)
                                    {
                                        <li class="page-item @(Model.PageNumber == 1 ? "active" : "")">
                                            <a class="page-link bg-dark text-light border-secondary" asp-action="Index"
                                               asp-route-pagina="1">1</a>
                                        </li>
                                        if (inicio > 2)
                                        {
                                            <li class="page-item disabled">
                                                <span class="page-link bg-dark text-light border-secondary">…</span>
                                            </li>
                                        }
                                    }

                                    @for (int i = inicio; i <= fin; i++)
                                    {
                                        <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                                            <a class="page-link bg-dark text-light border-secondary" asp-action="Index"
                                               asp-route-pagina="@i">@i</a>
                                        </li>
                                    }

                                    @if (fin < totalPaginas)
                                    {
                                        if (fin < totalPaginas - 1)
                                        {
                                            <li class="page-item disabled">
                                                <span class="page-link bg-dark text-light border-secondary">…</span>
                                            </li>
                                        }
                                        <li class="page-item @(Model.PageNumber == totalPaginas ? "active" : "")">
                                            <a class="page-link bg-dark text-light border-secondary" asp-action="Index"
                                               asp-route-pagina="@totalPaginas">@totalPaginas</a>
                                        </li>
                                    }

                                    <li class="page-item @(Model.PageNumber >= totalPaginas ? "disabled" : "")">
                                        <a class="page-link bg-dark text-light border-secondary" asp-action="Index"
                                           asp-route-pagina="@(Model.PageNumber + 1)" aria-label="Siguiente">&rsaquo;</a>
                                    </li>
                                </ul>
                            </nav>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</div>