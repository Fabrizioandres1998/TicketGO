@model TicketsGO.Services.PaginatedResult<TicketsGO.DTOs.TicketListDto>

@{
    ViewData["Title"] = "Mis tickets";
    var totalPaginas = (int)Math.Ceiling((double)Model.TotalCount / Model.PageSize);
}

<div class="container py-5 bg-dark text-light min-vh-100">
    <div class="row justify-content-center">
        <div class="col-12 col-xl-10">
            <div class="card bg-black border-secondary shadow-lg rounded-4">
                <div class="card-body p-4">

                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger bg-danger text-light border-0">@TempData["Error"]</div>
                    }
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success bg-success text-light border-0">@TempData["Success"]</div>
                    }

                    <h1 class="h3 fw-bold mb-4">Mis tickets</h1>

                    @if (!Model.Items.Any())
                    {
                        <div class="alert alert-dark border-secondary text-light text-center">
                            No tenés tickets todavía.
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-dark table-hover align-middle mb-0">
                                <thead class="border-bottom border-secondary">
                                    <tr>
                                        <th>Código</th>
                                        <th>Evento</th>
                                        <th>Fecha evento</th>
                                        <th>Estado</th>
                                        <th class="text-end">Acciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var t in Model.Items)
                                    {
                                        <tr>
                                            <td><code>@t.Codigo</code></td>
                                            <td>@t.Evento</td>
                                            <td>@t.FechaEvento.ToString("dd/MM/yyyy HH:mm")</td>
                                            <td>
                                                @if (t.Estado == "NoUsado")
                                                {
                                                    <span class="badge bg-success">@t.EstadoDisplayName</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">@t.EstadoDisplayName</span>
                                                }
                                            </td>
                                            <td class="text-end">
                                                <a asp-action="Details" asp-route-id="@t.Id" class="btn btn-sm btn-outline-info">Ver</a>
                                                @if (t.PuedeMarcarUsado)
                                                {
                                                    <form asp-action="MarcarUsado" asp-route-id="@t.Id" method="post" class="d-inline">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="btn btn-sm btn-success">Usar</button>
                                                    </form>
                                                }
                                                @if (t.PuedeTransferir)
                                                {
                                                    <a asp-action="Transferir" asp-route-id="@t.Id" class="btn btn-sm btn-outline-warning">Transferir</a>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        @if (totalPaginas > 1)
                        {
                            <nav class="mt-4">
                                <ul class="pagination justify-content-center mb-0">
                                    <li class="page-item @(Model.PageNumber <= 1 ? "disabled" : "")">
                                        <a class="page-link bg-dark text-light border-secondary" asp-action="MisTickets"
                                           asp-route-pagina="@(Model.PageNumber - 1)">&lsaquo;</a>
                                    </li>
                                    @for (int i = 1; i <= totalPaginas; i++)
                                    {
                                        <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                                            <a class="page-link bg-dark text-light border-secondary" asp-action="MisTickets"
                                               asp-route-pagina="@i">@i</a>
                                        </li>
                                    }
                                    <li class="page-item @(Model.PageNumber >= totalPaginas ? "disabled" : "")">
                                        <a class="page-link bg-dark text-light border-secondary" asp-action="MisTickets"
                                           asp-route-pagina="@(Model.PageNumber + 1)">&rsaquo;</a>
                                    </li>
                                </ul>
                            </nav>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</div>
