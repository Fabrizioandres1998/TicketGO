@{
    ViewData["Title"] = "Transferir ticket";
    var id = (int)ViewBag.Id;
    var evento = ViewBag.Evento as string;
    var codigo = ViewBag.Codigo as string;
}

<div id="app" class="container py-5 bg-dark text-light min-vh-100">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card bg-black border-secondary shadow-lg rounded-4">
                <div class="card-body p-4 p-md-5">

                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger bg-danger text-light border-0">@TempData["Error"]</div>
                    }

                    <h1 class="h3 fw-bold mb-4">Transferir ticket</h1>

                    <p class="text-white-50">Ticket <code>@codigo</code> — @evento</p>

                    <form asp-action="Transferir" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@id" />

                        <div class="mb-3 position-relative">
                            <label class="form-label">Email del destinatario</label>
                            <input v-model="busqueda" v-on:input="buscarUsuario" type="text"
                                   class="form-control bg-dark text-light border-secondary"
                                   placeholder="Escribí el email..." autocomplete="off" name="emailDestino" />
                            <div v-if="resultados.length > 0" class="list-group position-absolute w-100 mt-1"
                                 style="z-index:1000;">
                                <button type="button" v-for="u in resultados" :key="u.id"
                                        class="list-group-item list-group-item-action bg-dark text-light border-secondary"
                                        v-on:click="seleccionar(u)">
                                    {{ u.email }} — {{ u.nombre }} {{ u.apellido }}
                                </button>
                            </div>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-warning btn-lg flex-grow-1 fw-bold">Transferir</button>
                            <a asp-action="MisTickets" class="btn btn-outline-secondary btn-lg">Cancelar</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://unpkg.com/vue@3/dist/vue.global.js"></script>
    <script>
        const { createApp } = Vue;

        createApp({
            data() {
                return {
                    busqueda: '',
                    resultados: [],
                    debounceTimer: null
                };
            },
            methods: {
                buscarUsuario() {
                    clearTimeout(this.debounceTimer);
                    if (this.busqueda.trim().length < 3) {
                        this.resultados = [];
                        return;
                    }
                    this.debounceTimer = setTimeout(async () => {
                        const res = await fetch(`/api/usuarios/buscar?email=${encodeURIComponent(this.busqueda)}`);
                        if (res.ok) {
                            const data = await res.json();
                            this.resultados = data.items;
                        }
                    }, 300);
                },
                seleccionar(u) {
                    this.busqueda = u.email;
                    this.resultados = [];
                }
            }
        }).mount('#app');
    </script>
}