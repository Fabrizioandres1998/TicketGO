@model TicketsGO.Services.PaginatedResult<TicketsGO.DTOs.CompraListDto>

@{
    ViewData["Title"] = "Mis compras";
    var totalPaginas = (int)Math.Ceiling((double)Model.TotalCount / Model.PageSize);
}

<div class="container py-5 bg-dark text-light min-vh-100">
    <div class="row justify-content-center">
        <div class="col-12 col-xl-10">
            <div class="card bg-black border-secondary shadow-lg rounded-4">
                <div class="card-body p-4">

                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger bg-danger text-light border-0">@TempData["Error"]</div>
                    }
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success bg-success text-light border-0">@TempData["Success"]</div>
                    }

                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h1 class="h3 fw-bold mb-0">Mis compras</h1>
                        <a asp-action="Create" class="btn btn-success">+ Nueva compra</a>
                    </div>

                    @if (!Model.Items.Any())
                    {
                        <div class="alert alert-dark border-secondary text-light text-center">
                            No tenés compras registradas.
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-dark table-hover align-middle mb-0">
                                <thead class="border-bottom border-secondary">
                                    <tr>
                                        <th>#</th>
                                        <th>Evento</th>
                                        <th>Fecha evento</th>
                                        <th>Tickets</th>
                                        <th>Monto</th>
                                        <th>Estado</th>
                                        <th class="text-end">Acciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var compra in Model.Items)
                                    {
                                        <tr>
                                            <td>@compra.Id</td>
                                            <td>@compra.Evento</td>
                                            <td>@compra.FechaEvento.ToString("dd/MM/yyyy HH:mm")</td>
                                            <td>@compra.TotalTickets</td>
                                            <td>$@compra.MontoTotal</td>
                                            <td>
                                                @if (compra.Estado == "Realizada")
                                                {
                                                    <span class="badge bg-success">@compra.Estado</span>
                                                }
                                                else if (compra.Estado == "Cancelada")
                                                {
                                                    <span class="badge bg-danger">@compra.Estado</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-warning text-dark">@compra.Estado</span>
                                                }
                                            </td>
                                            <td class="text-end">
                                                @if (compra.Estado == "Realizada")
                                                {
                                                    <button type="button" class="btn btn-sm btn-outline-danger"
                                                            data-bs-toggle="modal" data-bs-target="#modalCancelar"
                                                            data-compra-id="@compra.Id" data-compra-evento="@compra.Evento"
                                                            data-compra-tickets="@compra.TotalTickets">
                                                        Devolver
                                                    </button>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        @if (totalPaginas > 1)
                        {
                            <nav class="mt-4">
                                <ul class="pagination justify-content-center mb-0">
                                    <li class="page-item @(Model.PageNumber <= 1 ? "disabled" : "")">
                                        <a class="page-link bg-dark text-light border-secondary" asp-action="MisCompras"
                                           asp-route-pagina="@(Model.PageNumber - 1)">&lsaquo;</a>
                                    </li>
                                    @for (int i = 1; i <= totalPaginas; i++)
                                    {
                                        <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                                            <a class="page-link bg-dark text-light border-secondary" asp-action="MisCompras"
                                               asp-route-pagina="@i">@i</a>
                                        </li>
                                    }
                                    <li class="page-item @(Model.PageNumber >= totalPaginas ? "disabled" : "")">
                                        <a class="page-link bg-dark text-light border-secondary" asp-action="MisCompras"
                                           asp-route-pagina="@(Model.PageNumber + 1)">&rsaquo;</a>
                                    </li>
                                </ul>
                            </nav>
                        }
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Modal de confirmación -->
    <div class="modal fade" id="modalCancelar" tabindex="-1" aria-labelledby="modalCancelarLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content bg-dark text-light border-secondary">
                <div class="modal-header border-secondary">
                    <h5 class="modal-title" id="modalCancelarLabel">Confirmar devolución</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"
                            aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <p>¿Seguro que querés devolver los <strong id="modalTickets"></strong> ticket(s) del evento <strong
                        id="modalEvento"></strong>?</p>
                        <p class="text-white-50 small mb-0">Esta acción no se puede deshacer. Los tickets volverán a estar
                            disponibles.</p>
                        </div>
                        <div class="modal-footer border-secondary">
                            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                            <form asp-action="Cancelar" method="post" id="formCancelar">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" id="inputCompraId" />
                                <button type="submit" class="btn btn-danger">Sí, devolver</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @section Scripts {
            <script>
                document.addEventListener('DOMContentLoaded', function () {
                    const modal = document.getElementById('modalCancelar');
                    modal.addEventListener('show.bs.modal', function (event) {
                        const button = event.relatedTarget;
                        const id = button.getAttribute('data-compra-id');
                        const evento = button.getAttribute('data-compra-evento');
                        const tickets = button.getAttribute('data-compra-tickets');

                        document.getElementById('inputCompraId').value = id;
                        document.getElementById('modalEvento').textContent = evento;
                        document.getElementById('modalTickets').textContent = tickets;
                    });
                });
            </script>
        }