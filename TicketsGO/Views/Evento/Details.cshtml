@model TicketsGO.DTOs.EventoDetailsDto

@{
    ViewData["Title"] = "Detalle del evento";
    var esProductorOAdmin = User.Identity?.IsAuthenticated == true &&
                             (User.IsInRole("Productor") || User.IsInRole("Administrador"));
}

<div class="container py-5 bg-dark text-light min-vh-100">
    <div class="row justify-content-center">
        <div class="col-md-10 col-lg-8">
            <div class="card bg-black border-secondary shadow-lg rounded-4">
                <div class="card-body p-4 p-md-5">

                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h1 class="h3 fw-bold mb-0">@Model.Nombre</h1>
                        <a asp-action="Public" class="btn btn-outline-light btn-sm">Volver</a>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.ImagenUrl))
                    {
                        <div class="text-center mb-4">
                            <img src="@Model.ImagenUrl" class="rounded border border-secondary img-fluid"
                                 style="max-height:300px;object-fit:cover;" />
                        </div>
                    }

                    <p class="text-white-50">@Model.Descripcion</p>

                    <dl class="row mb-0">
                        <dt class="col-sm-4 text-secondary">Fecha de inicio</dt>
                        <dd class="col-sm-8">@Model.FechaInicio.ToString("dd/MM/yyyy HH:mm")</dd>

                        <dt class="col-sm-4 text-secondary">Fecha de fin</dt>
                        <dd class="col-sm-8">@Model.FechaFin.ToString("dd/MM/yyyy HH:mm")</dd>

                        <dt class="col-sm-4 text-secondary">Ubicación</dt>
                        <dd class="col-sm-8">@Model.Establecimiento — @Model.Ciudad, @Model.Provincia</dd>

                        <dt class="col-sm-4 text-secondary">Privado</dt>
                        <dd class="col-sm-8">@(Model.Privado ? "Sí" : "No")</dd>

                        <dt class="col-sm-4 text-secondary">Precio</dt>
                        <dd class="col-sm-8">$@Model.PrecioTicket</dd>

                        <dt class="col-sm-4 text-secondary">Tickets</dt>
                        <dd class="col-sm-8">@Model.TicketsVendidos vendidos de @Model.TicketsTotales (@Model.TicketsDisponibles disponibles)</dd>

                        <dt class="col-sm-4 text-secondary">Estado</dt>
                        <dd class="col-sm-8">@Model.Estado</dd>

                        <dt class="col-sm-4 text-secondary">Productor</dt>
                        <dd class="col-sm-8">@Model.Productor</dd>
                    </dl>

                    <div class="d-flex gap-2 mt-4">
                        @if (esProductorOAdmin)
                        {
                            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-warning btn-lg fw-bold">Editar</a>
                        }
                        @if (User.Identity?.IsAuthenticated == true && User.IsInRole("Usuario"))
                        {
                            <button class="btn btn-success btn-lg fw-bold" disabled>Comprar (próximamente)</button>
                        }
                        <a asp-action="Public" class="btn btn-outline-secondary btn-lg">Volver</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
