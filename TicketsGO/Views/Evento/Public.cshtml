@model TicketsGO.Services.PaginatedResult<TicketsGO.DTOs.EventoListDto>

@{
    ViewData["Title"] = "Eventos";
    var totalPaginas = (int)Math.Ceiling((double)Model.TotalCount / Model.PageSize);
}

<div class="container py-5 bg-dark text-light min-vh-100">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 fw-bold mb-0">Eventos disponibles</h1>
    </div>

    @if (!Model.Items.Any())
    {
        <div class="alert alert-dark border-secondary text-light text-center">
            No hay eventos publicados por el momento.
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var evento in Model.Items)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card bg-black border-secondary shadow-lg rounded-4 h-100">
                        @if (!string.IsNullOrWhiteSpace(evento.ImagenUrl))
                        {
                            <img src="@evento.ImagenUrl" class="card-img-top rounded-top-4" style="height:180px;object-fit:cover;"
                                 alt="@evento.Nombre" />
                        }
                        else
                        {
                            <div class="d-flex align-items-center justify-content-center bg-secondary rounded-top-4"
                                 style="height:180px;">
                                <span class="text-white-50">Sin imagen</span>
                            </div>
                        }
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title fw-bold">@evento.Nombre</h5>
                            <p class="text-white-50 small mb-1">@evento.FechaInicio.ToString("dd/MM/yyyy HH:mm")</p>
                            <p class="text-white-50 small mb-3">@evento.Ubicacion</p>
                            <div class="mt-auto d-flex justify-content-between align-items-center">
                                <span class="badge bg-success">$@evento.PrecioTicket</span>
                                <a asp-action="Details" asp-route-id="@evento.Id" class="btn btn-sm btn-outline-info">Ver
                                    detalle</a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>

            @if (totalPaginas > 1)
            {
                <nav class="mt-4">
                    <ul class="pagination justify-content-center mb-0">
                        <li class="page-item @(Model.PageNumber <= 1 ? "disabled" : "")">
                            <a class="page-link bg-dark text-light border-secondary" asp-action="Public"
                               asp-route-pagina="@(Model.PageNumber - 1)">&lsaquo;</a>
                        </li>
                        @for (int i = 1; i <= totalPaginas; i++)
                        {
                            <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                                <a class="page-link bg-dark text-light border-secondary" asp-action="Public"
                                   asp-route-pagina="@i">@i</a>
                            </li>
                        }
                        <li class="page-item @(Model.PageNumber >= totalPaginas ? "disabled" : "")">
                            <a class="page-link bg-dark text-light border-secondary" asp-action="Public"
                               asp-route-pagina="@(Model.PageNumber + 1)">&rsaquo;</a>
                        </li>
                    </ul>
                </nav>
            }
        }
    </div>