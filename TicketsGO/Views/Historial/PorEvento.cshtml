@model TicketsGO.Services.PaginatedResult<TicketsGO.Models.Historial>

@{
    ViewData["Title"] = "Historial del evento";
    var totalPaginas = (int)Math.Ceiling((double)Model.TotalCount / Model.PageSize);
}

<div class="container py-5 bg-dark text-light min-vh-100">
    <div class="row justify-content-center">
        <div class="col-12 col-xl-10">
            <div class="card bg-black border-secondary shadow-lg rounded-4">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
                        <div>
                            <h1 class="h3 fw-bold mb-1">Historial del evento</h1>
                            <p class="text-white-50 mb-0">@ViewBag.NombreEvento</p>
                        </div>
                        <a asp-controller="Evento" asp-action="Details" asp-route-id="@ViewBag.IdEvento" class="btn btn-outline-light">Volver al evento</a>
                    </div>

                    @if (!Model.Items.Any())
                    {
                        <div class="alert alert-dark border-secondary text-light text-center mb-0">Este evento todavía no tiene movimientos registrados.</div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-dark table-hover align-middle mb-0">
                                <thead class="border-bottom border-secondary">
                                    <tr><th>Fecha</th><th>Usuario</th><th>Movimiento</th></tr>
                                </thead>
                                <tbody>
                                    @foreach (var movimiento in Model.Items)
                                    {
                                        <tr>
                                            <td class="text-nowrap">@movimiento.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                                            <td>@(movimiento.Usuario == null ? "—" : $"{movimiento.Usuario.Nombre} {movimiento.Usuario.Apellido}")</td>
                                            <td>@movimiento.Descripcion</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        @if (totalPaginas > 1)
                        {
                            <nav class="mt-4" aria-label="Páginas del historial">
                                <ul class="pagination justify-content-center mb-0">
                                    @for (var i = 1; i <= totalPaginas; i++)
                                    {
                                        <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                                            <a class="page-link bg-dark text-light border-secondary" asp-action="PorEvento" asp-route-idEvento="@ViewBag.IdEvento" asp-route-pagina="@i">@i</a>
                                        </li>
                                    }
                                </ul>
                            </nav>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</div>
